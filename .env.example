APP_NAME=TaskHub
APP_VERSION=0.1.0
DEBUG=false

# Async SQLAlchemy DSN. MySQL 8 example (root with no password):
DATABASE_URL=mysql+aiomysql://root@127.0.0.1:3306/taskhub
# PostgreSQL 16 example:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/taskhub
DB_ECHO=false

# --- Authentication & Authorization
# Secret dùng để ký JWT. PHẢI đủ dài (min 32 ký tự), KHÔNG để rỗng.
# Đổi giá trị này trong production.
SECRET_KEY=dev-secret-key-change-me-please-32chars-min
# Thuật toán ký JWT.
JWT_ALGORITHM=HS256
# Thời hạn access token (phút) và refresh token (ngày).
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
